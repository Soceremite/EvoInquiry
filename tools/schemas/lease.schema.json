{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoInquiry lease v1",
  "type": "object",
  "required": [
    "schema_version",
    "lease_id",
    "consumer_id",
    "env_revision",
    "job_ref",
    "status",
    "heartbeat_at",
    "expires_at",
    "termination_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "consumer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "env_revision": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "job_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "released"
      ]
    },
    "heartbeat_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "termination_receipt": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
