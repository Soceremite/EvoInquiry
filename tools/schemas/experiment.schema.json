{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoInquiry experiment v1",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "spec_revision",
    "spec_sha256",
    "hypothesis",
    "variants",
    "protocol_ref",
    "data_ref",
    "split_ref",
    "evaluator_ref",
    "seeds",
    "budget",
    "decision_rule",
    "failure_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "variant_id",
          "configuration"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "configuration": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "protocol_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "split_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evaluator_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "budget": {
      "type": "object",
      "minProperties": 1
    },
    "decision_rule": {
      "type": "object",
      "minProperties": 1
    },
    "failure_policy": {
      "type": "object",
      "required": [
        "aggregation"
      ],
      "properties": {
        "aggregation": {
          "enum": [
            "first-success",
            "last-success",
            "all-attempts"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment_requirements": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
