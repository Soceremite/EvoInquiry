{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoInquiry environment v1",
  "type": "object",
  "required": [
    "schema_version",
    "env_id",
    "revision",
    "recipe_ref",
    "lock_ref",
    "build_ref",
    "platform",
    "interpreter",
    "expected_fingerprint",
    "observed_fingerprint",
    "test_receipts",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "env_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "recipe_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lock_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "build_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "interpreter": {
      "type": "string",
      "minLength": 1
    },
    "expected_fingerprint": {
      "type": "object",
      "minProperties": 1
    },
    "observed_fingerprint": {
      "type": "object",
      "minProperties": 1
    },
    "test_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifact_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "lifecycle": {
      "enum": [
        "candidate",
        "rejected",
        "frozen",
        "retired"
      ]
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "consumer_inventory_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
