{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoInquiry execution v1",
  "type": "object",
  "required": [
    "schema_version",
    "execution_run_id",
    "workflow_run_id",
    "spec_ref",
    "variant_id",
    "seed",
    "snapshot_ref",
    "env_revision",
    "observed_fingerprint",
    "job_ref",
    "retry_of",
    "resumed_from",
    "checkpoint_ref",
    "status",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "workflow_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "spec_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "seed": {
      "type": "integer"
    },
    "snapshot_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "env_revision": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observed_fingerprint": {
      "type": "object",
      "minProperties": 1
    },
    "job_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resumed_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "queued",
        "running",
        "completed",
        "failed",
        "stopped"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "event_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifact_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    }
  },
  "additionalProperties": false
}
